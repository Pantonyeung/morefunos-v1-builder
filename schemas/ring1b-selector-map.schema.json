{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morefunos.local/schemas/ring1b-selector-map.schema.json",
  "title": "MoreFunOS Ring1B Selector Map",
  "type": "object",
  "required": ["schema_version", "selectors"],
  "properties": {
    "schema_version": {"const": 1},
    "selectors": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "resource_id": {"type": "string"},
          "text": {"type": "string"},
          "text_contains": {"type": "string", "minLength": 1},
          "content_desc": {"type": "string"},
          "bounds": {
            "oneOf": [
              {"type": "string", "pattern": "^\\[\\d+,\\d+\\]\\[\\d+,\\d+\\]$"},
              {"type": "array", "prefixItems": [{"type": "integer"}, {"type": "integer"}, {"type": "integer"}, {"type": "integer"}], "minItems": 4, "maxItems": 4}
            ]
          }
        },
        "additionalProperties": false,
        "anyOf": [
          {"required": ["resource_id"]},
          {"required": ["text"]},
          {"required": ["text_contains"]},
          {"required": ["content_desc"]},
          {"required": ["bounds"]}
        ]
      }
    }
  },
  "additionalProperties": false
}
