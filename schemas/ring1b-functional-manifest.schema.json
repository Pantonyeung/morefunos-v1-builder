{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morefunos.local/schemas/ring1b-functional-manifest.schema.json",
  "title": "MoreFunOS Ring1B Functional Scenario Manifest",
  "type": "object",
  "required": ["schema_version", "scenario_id", "package_id", "main_activity", "steps"],
  "properties": {
    "schema_version": {"const": 1},
    "scenario_id": {"type": "string", "minLength": 1},
    "package_id": {"type": "string", "minLength": 1},
    "main_activity": {"type": "string", "minLength": 1},
    "timeouts": {
      "type": "object",
      "properties": {
        "transition_ms": {"type": "integer", "minimum": 1, "maximum": 60000},
        "poll_ms": {"type": "integer", "minimum": 1, "maximum": 60000}
      },
      "additionalProperties": false
    },
    "fault_text_patterns": {"type": "array", "items": {"type": "string"}},
    "fault_activity_patterns": {"type": "array", "items": {"type": "string"}},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "action"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "action": {"enum": ["launch", "tap", "checkpoint", "restart", "process_death", "network"]},
          "target": {"type": "string", "minLength": 1},
          "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 60000},
          "tap_count": {"type": "integer", "minimum": 1, "maximum": 4},
          "tap_interval_ms": {"type": "integer", "minimum": 0, "maximum": 1000},
          "allow_preexisting_expectation": {"type": "boolean"},
          "state": {"enum": ["OFFLINE", "ONLINE"]},
          "expect": {
            "type": "object",
            "properties": {
              "present": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "absent": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "activity_contains": {"type": "string"}
            },
            "additionalProperties": false
          },
          "persistence": {
            "type": "object",
            "required": ["mode"],
            "properties": {
              "mode": {"enum": ["PRESERVE", "RESET_EXPECTED", "RECOVER"]},
              "before": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "after": {"type": "array", "items": {"type": "string", "minLength": 1}}
            },
            "additionalProperties": false
          },
          "store_kernel": {
            "type": "object",
            "required": ["checkpoint"],
            "properties": {
              "checkpoint": {"type": "string", "minLength": 1},
              "compare_to": {"type": "string", "minLength": 1},
              "transaction_delta": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "integer", "minimum": 0, "maximum": 16}
              },
              "tenders": {
                "type": "array",
                "items": {"enum": ["CASH", "ALIPAY", "WECHAT_PAY", "FPS", "PAYME"]}
              },
              "require_pending_outbox": {"type": "boolean"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
