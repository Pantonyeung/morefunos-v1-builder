{
  "schema_version": 1,
  "scenario_id": "867-chain4-payment-certainty-nominal-prep",
  "package_id": "com.morefunos.smt",
  "main_activity": ".MainActivity",
  "timeouts": {
    "transition_ms": 15000,
    "poll_ms": 300
  },
  "fault_text_patterns": [
    "Owner 管理密碼",
    "員工 PIN",
    "配對此收銀機",
    "SMT 發生故障"
  ],
  "steps": [
    {
      "id": "boot-auth-deferred-menu",
      "action": "launch",
      "expect": {
        "present": ["auth_deferred", "menu_category", "product_riceball", "product_combo", "cart_empty"],
        "absent": ["mock_core_authority", "payment_success"]
      }
    },
    {
      "id": "open-non-production-provenance",
      "action": "tap",
      "target": "more_nav",
      "expect": {
        "present": ["auth_deferred", "simulation_actor", "simulation_context"],
        "absent": ["payment_success"]
      }
    },
    {
      "id": "return-to-ordering",
      "action": "tap",
      "target": "return_ordering",
      "expect": {
        "present": ["auth_deferred", "menu_category", "product_riceball", "product_combo", "cart_empty"]
      }
    },
    {
      "id": "open-normal-product",
      "action": "tap",
      "target": "product_riceball",
      "expect": {
        "present": ["product_config", "required_missing", "option_nori", "confirm_add"]
      }
    },
    {
      "id": "select-normal-product-modifier",
      "action": "tap",
      "target": "option_nori",
      "expect": {
        "present": ["modifier_ready", "confirm_add", "product_config"]
      }
    },
    {
      "id": "add-normal-product-to-cart",
      "action": "tap",
      "target": "confirm_add",
      "expect": {
        "present": ["cart_product_riceball", "cart_note_nori", "cart_total_50"],
        "absent": ["product_config"]
      }
    },
    {
      "id": "open-combo",
      "action": "tap",
      "target": "product_combo",
      "expect": {
        "present": ["combo_workspace", "combo_required_3", "choice_combo_riceball", "combo_add"]
      }
    },
    {
      "id": "select-combo-riceball",
      "action": "tap",
      "target": "choice_combo_riceball",
      "expect": {
        "present": ["combo_required_2", "choice_combo_snack", "combo_add"]
      }
    },
    {
      "id": "select-combo-snack",
      "action": "tap",
      "target": "choice_combo_snack",
      "expect": {
        "present": ["combo_required_1", "choice_combo_drink", "combo_add"]
      }
    },
    {
      "id": "select-combo-drink",
      "action": "tap",
      "target": "choice_combo_drink",
      "expect": {
        "present": ["combo_complete", "combo_quote_50", "combo_add"]
      }
    },
    {
      "id": "add-combo-to-cart",
      "action": "tap",
      "target": "combo_add",
      "expect": {
        "present": ["cart_product_riceball", "cart_note_nori", "cart_combo_riceball", "cart_combo_snack", "cart_combo_drink", "cart_total_100"],
        "absent": ["combo_workspace"]
      }
    },
    {
      "id": "stage-chain3-checkout-intent",
      "action": "tap",
      "target": "checkout",
      "expect": {
        "present": ["checkout_workspace", "checkout_intent_staged", "payment_not_invoked", "frozen_checkpoint", "chain3_binding_bound", "bound_trace_identity"]
      }
    },
    {
      "id": "observe-real-last-known-good-payment-configuration",
      "action": "checkpoint",
      "expect": {
        "present": ["auth_deferred", "chain4_methods_visible", "payment_config_status_published", "payment_config_source_lkg", "payment_config_version_nonproduction", "payment_config_revision_one", "payment_method_cash", "payment_method_fps", "payment_not_invoked"],
        "absent": ["payment_boundary_invoked", "payment_success"]
      }
    },
    {
      "id": "bind-exact-cash",
      "action": "tap",
      "target": "exact_cash",
      "expect": {
        "present": ["payment_method_cash", "cash_input_100", "confirm_payment", "payment_not_invoked", "payment_config_source_lkg"],
        "absent": ["payment_boundary_invoked", "payment_success"]
      }
    },
    {
      "id": "confirm-cash-payment",
      "action": "tap",
      "target": "confirm_payment",
      "expect": {
        "present": ["auth_deferred", "checkout_workspace", "payment_boundary_invoked", "chain4_methods_visible", "payment_config_status_published", "payment_config_source_lkg", "payment_config_version_nonproduction", "payment_config_revision_one", "payment_certainty", "payment_attempt_id", "payment_status_confirmed", "payment_replay_safe_true", "payment_result_confirmed"],
        "absent": ["payment_success"]
      }
    },
    {
      "id": "restart-confirmed-payment-readback",
      "action": "restart",
      "timeout_ms": 15000,
      "persistence": {
        "mode": "RECOVER",
        "before": ["payment_certainty", "payment_attempt_id", "payment_status_confirmed", "payment_replay_safe_true", "payment_result_confirmed"],
        "after": ["auth_deferred", "checkout_workspace", "payment_boundary_invoked", "chain4_methods_visible", "payment_config_status_published", "payment_config_source_lkg", "payment_config_version_nonproduction", "payment_config_revision_one", "payment_certainty", "payment_attempt_id", "payment_status_confirmed", "payment_replay_safe_true", "payment_result_confirmed"]
      }
    },
    {
      "id": "assert-no-store-commit-success-required",
      "action": "checkpoint",
      "expect": {
        "present": ["payment_status_confirmed", "payment_replay_safe_true", "payment_result_confirmed"],
        "absent": ["payment_success"]
      }
    }
  ]
}
