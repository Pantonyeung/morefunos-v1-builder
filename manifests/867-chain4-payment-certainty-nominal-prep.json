{
  "schema_version": 1,
  "scenario_id": "867-chain4-payment-certainty-nominal-prep",
  "package_id": "com.morefunos.smt",
  "main_activity": ".MainActivity",
  "timeouts": {
    "transition_ms": 15000,
    "poll_ms": 300
  },
  "fault_text_patterns": [
    "Owner 管理密碼",
    "員工 PIN",
    "配對此收銀機",
    "SMT 發生故障"
  ],
  "steps": [
    {
      "id": "boot-local-sovereign-menu-with-core-d1-unavailable",
      "action": "launch",
      "expect": {
        "present": [
          "auth_deferred",
          "admin_config_revision_applied",
          "admin_config_revision",
          "smt_live_transaction_owner",
          "core_connector_only",
          "d1_transport_only",
          "core_d1_unavailable",
          "local_flow_admitted",
          "menu_category",
          "product_riceball",
          "product_combo",
          "cart_empty"
        ],
        "absent": ["config_revision_missing", "config_revision_invalid", "local_flow_forbidden", "mock_core_authority"]
      }
    },
    {
      "id": "open-normal-product",
      "action": "tap",
      "target": "product_riceball",
      "expect": {
        "present": ["product_config", "required_missing", "option_nori", "confirm_add"]
      }
    },
    {
      "id": "select-normal-product-modifier",
      "action": "tap",
      "target": "option_nori",
      "expect": {
        "present": ["modifier_ready", "confirm_add", "product_config"]
      }
    },
    {
      "id": "add-normal-product-to-cart",
      "action": "tap",
      "target": "confirm_add",
      "expect": {
        "present": ["cart_product_riceball", "cart_note_nori", "cart_total_50"],
        "absent": ["product_config"]
      }
    },
    {
      "id": "open-combo",
      "action": "tap",
      "target": "product_combo",
      "expect": {
        "present": ["combo_workspace", "combo_required_3", "choice_combo_riceball", "combo_add"]
      }
    },
    {
      "id": "select-combo-riceball",
      "action": "tap",
      "target": "choice_combo_riceball",
      "expect": {
        "present": ["combo_required_2", "choice_combo_snack", "combo_add"]
      }
    },
    {
      "id": "select-combo-snack",
      "action": "tap",
      "target": "choice_combo_snack",
      "expect": {
        "present": ["combo_required_1", "choice_combo_drink", "combo_add"]
      }
    },
    {
      "id": "select-combo-drink",
      "action": "tap",
      "target": "choice_combo_drink",
      "expect": {
        "present": ["combo_complete", "combo_quote_50", "combo_add"]
      }
    },
    {
      "id": "add-combo-to-cart",
      "action": "tap",
      "target": "combo_add",
      "expect": {
        "present": ["cart_product_riceball", "cart_note_nori", "cart_combo_riceball", "cart_combo_snack", "cart_combo_drink", "cart_total_100"],
        "absent": ["combo_workspace"]
      }
    },
    {
      "id": "stage-chain3-checkout-intent",
      "action": "tap",
      "target": "checkout",
      "expect": {
        "present": ["checkout_workspace", "checkout_intent_staged", "payment_not_invoked", "frozen_checkpoint", "chain3_binding_bound", "bound_trace_identity"]
      }
    },
    {
      "id": "observe-payment-methods",
      "action": "checkpoint",
      "expect": {
        "present": ["auth_deferred", "admin_config_revision_applied", "smt_live_transaction_owner", "core_d1_unavailable", "local_flow_admitted", "chain4_methods_visible", "payment_method_cash", "payment_method_fps", "payment_not_invoked"],
        "absent": ["config_revision_missing", "config_revision_invalid", "local_flow_forbidden", "mock_core_authority", "payment_request_transition", "store_commit_succeeded"]
      }
    },
    {
      "id": "select-cash-payment",
      "action": "tap",
      "target": "payment_method_cash",
      "expect": {
        "present": ["payment_method_selected_cash", "payment_not_invoked"],
        "absent": ["payment_request_transition", "store_commit_succeeded"]
      }
    },
    {
      "id": "bind-exact-cash",
      "action": "tap",
      "target": "exact_cash",
      "expect": {
        "present": ["payment_tender_ready", "payment_method_selected_cash", "payment_not_invoked"],
        "absent": ["payment_request_transition", "store_commit_succeeded"]
      }
    },
    {
      "id": "request-payment",
      "action": "tap",
      "target": "confirm_payment",
      "expect": {
        "present": [
          "payment_request_transition",
          "payment_certainty_confirmed",
          "payment_request_id",
          "payment_idempotency_key",
          "payment_bound_trace_identity",
          "payment_readback_state",
          "payment_replay_count_zero"
        ],
        "absent": ["payment_not_invoked", "store_commit_succeeded"]
      }
    },
    {
      "id": "restart-confirmed-payment-readback",
      "action": "restart",
      "timeout_ms": 15000,
      "persistence": {
        "mode": "RECOVER",
        "before": [
          "payment_certainty_confirmed",
          "payment_request_id",
          "payment_idempotency_key",
          "payment_bound_trace_identity",
          "payment_readback_state",
          "payment_replay_count_zero"
        ],
        "after": [
          "payment_restart_readback_recovered",
          "payment_certainty_confirmed",
          "payment_request_id",
          "payment_idempotency_key",
          "payment_bound_trace_identity",
          "payment_readback_state",
          "payment_replay_count_zero"
        ]
      }
    },
    {
      "id": "assert-no-store-commit-success-required",
      "action": "checkpoint",
      "expect": {
        "present": ["payment_certainty_confirmed", "payment_restart_readback_recovered"],
        "absent": ["store_commit_succeeded"]
      }
    }
  ]
}
