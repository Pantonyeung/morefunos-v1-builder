{
  "schema_version": 1,
  "scenario_id": "867-chain4-config-revision-missing-prep",
  "package_id": "com.morefunos.smt",
  "main_activity": ".MainActivity",
  "timeouts": {
    "transition_ms": 15000,
    "poll_ms": 300
  },
  "fault_text_patterns": [
    "Owner 管理密碼",
    "員工 PIN",
    "配對此收銀機",
    "SMT 發生故障"
  ],
  "steps": [
    {
      "id": "boot-auth-deferred-menu",
      "action": "launch",
      "expect": {
        "present": ["auth_deferred", "menu_category", "product_riceball", "cart_empty"],
        "absent": ["mock_core_authority", "payment_success"]
      }
    },
    {
      "id": "open-normal-product",
      "action": "tap",
      "target": "product_riceball",
      "expect": {
        "present": ["product_config", "required_missing", "option_nori", "confirm_add"]
      }
    },
    {
      "id": "select-normal-product-modifier",
      "action": "tap",
      "target": "option_nori",
      "expect": {
        "present": ["modifier_ready", "confirm_add", "product_config"]
      }
    },
    {
      "id": "add-normal-product-to-cart",
      "action": "tap",
      "target": "confirm_add",
      "expect": {
        "present": ["cart_product_riceball", "cart_note_nori", "cart_total_50"],
        "absent": ["product_config"]
      }
    },
    {
      "id": "stage-checkout-with-missing-configuration",
      "action": "tap",
      "target": "checkout",
      "expect": {
        "present": ["checkout_workspace", "checkout_intent_staged", "payment_not_invoked", "frozen_checkpoint", "chain3_binding_bound", "bound_trace_identity"]
      }
    },
    {
      "id": "missing-configuration-is-deterministically-blocked",
      "action": "checkpoint",
      "expect": {
        "present": ["chain4_methods_visible", "payment_config_status_blocked", "payment_config_source_missing", "payment_config_blocked_message", "payment_not_invoked"],
        "absent": ["payment_method_cash", "payment_method_fps", "payment_boundary_invoked", "payment_success"]
      }
    }
  ]
}
